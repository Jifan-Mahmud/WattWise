# MongoDB Atlas or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wattwise

# Better Auth secret (32+ random characters) & base URL
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000
