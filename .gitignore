# ==========================================
# WATTWISE - Root .gitignore
# Covers Frontend (Next.js) & Backend (Node.js / Express.js)
# ==========================================

# Dependencies (Root, Frontend, Backend)
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js Build Outputs (Frontend)
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Runtime data & PIDs
pids
*.pid
*.seed
*.pid.lock

# Testing & Coverage
coverage/
*/coverage/
*.lcov
.nyc_output

# Caching & Build tools
.turbo/
*/.turbo/
.cache/
*/.cache/
.parcel-cache

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
